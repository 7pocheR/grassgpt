n_head = 8
n_embd = 512
block_size = 1024
dropout = 0.1
bias = False

# Pure AdamW (no Grassmann, no gating)
use_grassmann = False

# Training hyperparameters
learning_rate = 6e-4
max_iters = 10000  # ~15B tokens, enough for convergence signal
warmup_iters = 1000
lr_decay_iters = 10000
min_lr = 6e-5

# Batch configuration (same as Grassmann for fair comparison)
batch_size = 32
gradient_accumulation_steps = 12

# Regularization
