Overriding config with config/train_gpt2_small_baseline.py:
# Small-scale GPT: Pure AdamW Baseline
# Control experiment for Grassmann comparison
# ~50M params, 6 layers, d=512

# Architecture (small-scale)
n_layer = 6
n_head = 8
n_embd = 512
block_size = 1024
dropout = 0.1
bias = False

# Pure AdamW (no Grassmann, no gating)
use_grassmann = False

# Training hyperparameters
learning_rate = 6e-4
max_iters = 10000  # ~15B tokens, enough for convergence signal
warmup_iters = 1000
lr_decay_iters = 10000
min_lr = 6e-5

# Batch configuration (same as Grassmann for fair comparison)
batch_size = 32
gradient_accumulation_steps = 12

# Regularization
weight_decay = 1e-1

# Optimizer
beta1 = 0.9
beta2 = 0.95
grad_clip = 1.0

# Evaluation
eval_interval = 500
eval_iters = 200
log_interval = 10

# Dataset
dataset = 'openwebtext'
data_dir = '/net/scratch2/junyuren/nanoGPT-manifold/data/openwebtext'
always_save_checkpoint = True

# Output directory
out_dir = '/net/scratch2/junyuren/nanoGPT-manifold/out-small-baseline'

# Compile
compile = True

# System
dtype = 'bfloat16'
device = 'cuda'

