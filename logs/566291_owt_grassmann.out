Overriding config with config/train_openwebtext_grassmann.py:
# Train Grassmann GPT on OpenWebText (stable_rank_x2 strategy)
# Model: 12L x 768d (~40M params)
# Dataset: 9B tokens
# Apply winning config from Shakespeare: stable_rank_x2

# I/O
out_dir = '/net/scratch2/junyuren/nanoGPT-manifold/out-openwebtext-grassmann'
eval_interval = 1000
eval_iters = 200
log_interval = 10
always_save_checkpoint = True

wandb_log = False
wandb_project = 'openwebtext'
wandb_run_name = 'grassmann-12L-768d-stable-rank-x2'

# Data
dataset = 'openwebtext'
data_dir = '/net/scratch2/junyuren/nanoGPT-manifold/data/openwebtext'
gradient_accumulation_steps = 40  # Simulate batch size of 480K tokens
batch_size = 12  # What fits in H100 memory
block_size = 1024  # OpenWebText uses 1024 context

# Model - 12L x 768d (~40M params)
n_layer = 12
n_head = 12
n_embd = 768
dropout = 0.1  # Half of baseline (Grassmann needs less dropout)

# AdamW optimizer (for non-Grassmann params)
learning_rate = 6e-4  # Same as baseline for AdamW components
max_iters = 100000
lr_decay_iters = 100000
min_lr = 6e-5
beta2 = 0.95
weight_decay = 0.1

warmup_iters = 2000

# System
dtype = 'bfloat16'
compile = True

# Grassmann configuration - stable_rank_x2 strategy
use_grassmann = True

# Stable rank from Shakespeare baseline (6L x 384d):
# - c_attn: stable_rank ~24, so stable_rank_x2 = 48
# - mlp.c_fc: stable_rank ~10, so stable_rank_x2 = 20
#
# For OpenWebText (12L x 768d), scale proportionally:
# - Width ratio: 768/384 = 2×
# - stable_rank_x2 scaled: c_attn: 48×2 = 96, mlp.c_fc: 20×2 = 40

grass_rank_c_attn = 96   # 2× stable_rank for c_attn
grass_rank_mlp_fc = 40   # 2× stable_rank for mlp.c_fc

# Operator norm scaling (will need to measure from baseline first)
# Using conservative estimate based on Shakespeare scaling
# Shakespeare: c_attn ~4.6, mlp.c_fc ~10.1
# Expect similar for OpenWebText due to initialization
grass_scale_c_attn = 4.6
grass_scale_mlp_fc = 10.1

# Learning rates (from Shakespeare winning config)
grass_lr = 6e-3  # ~10× boost from baseline (stable_rank_x2 used 6e-3 on Shakespeare)

# Grassmann parametrization
grass_a = 1.0  # c_attn (no skip)
grass_b = 0.0
grass_alpha = 0.01
grass_steps = 10
grass_tol = 1e-6

