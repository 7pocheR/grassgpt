Overriding config with config/phase2.2_mlp_noskip.py:
# Phase 2.2: mlp.c_fc + attn.c_proj (derived from phase2, attn.c_proj uses G(1,0,r) + no skip)
# Coverage: ~34% of parameters
# Test if attn.c_proj benefits from G(1,0,r) with MLP expansion

out_dir = '/net/scratch2/junyuren/nanoGPT-manifold/out-phase2.2-mlp-noskip'
eval_interval = 500
eval_iters = 200
log_interval = 10
always_save_checkpoint = True

wandb_log = False
wandb_project = 'nanogpt-manifold'
wandb_run_name = 'phase2.2-mlp-noskip'

# Dataset
dataset = 'shakespeare_char'
gradient_accumulation_steps = 1
batch_size = 64
block_size = 256

# Baby GPT architecture
n_layer = 6
n_head = 6
n_embd = 384
dropout = 0.2  # Match baseline (nanoGPT standard for Shakespeare)
bias = False

# AdamW for non-Grassmann params
learning_rate = 1e-3
max_iters = 15000
lr_decay_iters = 15000
min_lr = 1e-4
weight_decay = 1e-1  # Match baseline
beta1 = 0.9
beta2 = 0.99  # Match baseline (standard for small token count)
grad_clip = 1.0

decay_lr = True
warmup_iters = 100

# Grassmann config
use_grassmann = True
grassmann_phase = 'phase2.2'  # .2 = attn.c_proj uses G(1,0,r) + remove skip

# Legacy params
grass_lr = 8e-3
grass_a = 1.0
grass_b = 0.0
grass_rank = 192
grass_alpha = 0.01
grass_steps = 10
grass_tol = 1e-6

# System
device = 'cuda'
dtype = 'bfloat16'
compile = True

