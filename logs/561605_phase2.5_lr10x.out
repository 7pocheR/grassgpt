# Phase 2.5 LR Sweep: 10× multiplier (.010)
# Base: stable_rank_x2 (r=48,20, scale=4.63,10.14)

out_dir = '/net/scratch2/junyuren/nanoGPT-manifold/out-phase2.5-lr10x'
eval_interval = 500
eval_iters = 200
log_interval = 10
always_save_checkpoint = True

wandb_log = False
wandb_project = 'nanogpt-manifold'
wandb_run_name = 'phase2.5-lr10x'

dataset = 'shakespeare_char'
gradient_accumulation_steps = 1
batch_size = 64
block_size = 256

n_layer = 6
n_head = 6
n_embd = 384
dropout = 0.2
bias = False

learning_rate = 1e-3
max_iters = 15000
lr_decay_iters = 15000
min_lr = 1e-4
weight_decay = 1e-1
beta1 = 0.9
beta2 = 0.99
grad_clip = 1.0

decay_lr = True
warmup_iters = 100

use_grassmann = True
grassmann_phase = 'phase2.5'

