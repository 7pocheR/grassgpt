out_dir = '/net/scratch2/junyuren/nanoGPT-manifold/out-openwebtext-lr6x'
init_from = 'resume'
eval_interval = 1000
eval_iters = 200
log_interval = 10
always_save_checkpoint = True

wandb_log = False
wandb_project = 'openwebtext'
wandb_run_name = 'grassmann-6L-384d-lr6x'

# Data
